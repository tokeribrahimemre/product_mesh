{
  "Jwt": {
    "Secret": "ProductMeshSuperSecretKeyThatIsLongEnough2024!",
    "Issuer": "ProductMesh.Auth",
    "Audience": "ProductMesh"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "AuthRateLimit",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "GlobalRateLimit",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "logs-route": {
        "ClusterId": "log-cluster",
        "RateLimiterPolicy": "GlobalRateLimit",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-api": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "log-cluster": {
        "Destinations": {
          "log-api": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
