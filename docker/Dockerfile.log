FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/Shared/ProductMesh.Shared/ProductMesh.Shared.csproj", "src/Shared/ProductMesh.Shared/"]
COPY ["src/Services/Log/ProductMesh.Log.Domain/ProductMesh.Log.Domain.csproj", "src/Services/Log/ProductMesh.Log.Domain/"]
COPY ["src/Services/Log/ProductMesh.Log.Application/ProductMesh.Log.Application.csproj", "src/Services/Log/ProductMesh.Log.Application/"]
COPY ["src/Services/Log/ProductMesh.Log.Infrastructure/ProductMesh.Log.Infrastructure.csproj", "src/Services/Log/ProductMesh.Log.Infrastructure/"]
COPY ["src/Services/Log/ProductMesh.Log.API/ProductMesh.Log.API.csproj", "src/Services/Log/ProductMesh.Log.API/"]
RUN dotnet restore "src/Services/Log/ProductMesh.Log.API/ProductMesh.Log.API.csproj"
COPY . .
WORKDIR "/src/src/Services/Log/ProductMesh.Log.API"
RUN dotnet build -c Release -o /app/build

FROM build AS publish
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ProductMesh.Log.API.dll"]
